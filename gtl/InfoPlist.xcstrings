    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GTL uses your location to record the route and show it on the map. After you tap Start, recording continues while the screen is locked until you tap Stop."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A GTL a helyzetedet az útvonal rögzítéséhez és a térképen való mutatáshoz használja. Az Indítás után a rögzítés zárolt képernyőn is folytatódik, amíg a Leállítást meg nem nyomod."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GTL reads motion and barometric pressure to store lean angle and barometric altitude with the route."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A GTL a mozgást és a légnyomást a dőlésszög és a barometrikus magasság rögzítéséhez olvassa."
          }
        }
      }
    },
    "PreciseRoute" : {
      "comment" : "Temporary full accuracy purpose key",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precise location is required to record a usable route."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A használható nyomvonalhoz pontos hely kell."
          }
        }
      }
    }
  },
  "version" : "1.0"
}